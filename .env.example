# Google Maps Directions API key
GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# Tailscale IP of this PC, usually 100.x.x.x
PC_TAILSCALE_IP="100.x.x.x"

# Tailscale IP of the Android phone running MacroDroid HTTP Server
PHONE_TAILSCALE_IP="100.x.x.x"

# Dashboard login secret.
# Use a long random value. Minimum accepted length is 16 characters.
API_SECRET_KEY="replace_with_a_long_random_secret"

# API-only access key and Flask session signing secret. Use distinct random values.
API_ACCESS_KEY="replace_with_a_different_random_secret"
FLASK_SESSION_SECRET="replace_with_another_random_secret"

# false: Waitress serves localhost-only HTTP for development.
# true : Flask binds to localhost HTTP and Caddy handles HTTPS.
USE_CADDY="false"

# Bare-metal Flask port. Docker always listens on port 5050 inside the container.
FLASK_PORT=5050

# Host port published by Docker Compose (pass .env with --env-file).
HOST_PORT=5050

# Runtime timezone
TZ="Asia/Taipei"
